---
layout: base.njk
---

<section class="hero">
  <div class="hero-image-container">
    <img src="{{ pages.home.heroImage }}" alt="Mácsai Pottery" class="hero-image">
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-content">
    <h1 class="hero-title" data-en="{{ pages.home.heroTitle.en }}" data-hu="{{ pages.home.heroTitle.hu }}">{{ pages.home.heroTitle.hu }}</h1>
    <p class="hero-subtitle" data-en="{{ pages.home.heroSubtitle.en }}" data-hu="{{ pages.home.heroSubtitle.hu }}">{{ pages.home.heroSubtitle.hu }}</p>
    <a href="/available/" class="btn btn-primary" data-en="{{ sitewide.navigation.nav.available.en }}" data-hu="{{ sitewide.navigation.nav.available.hu }}">{{ sitewide.navigation.nav.available.hu }}</a>
  </div>
</section>

<section class="intro-section">
  <div class="container">
    <div data-en="{{ pages.home.intro.en }}" data-hu="{{ pages.home.intro.hu }}">
      {{ pages.home.intro.hu | safe }}
    </div>
  </div>
</section>

<section class="featured-pieces">
  <div class="container">
    <h2 class="section-title" data-en="{{ pages.home.featuredTitle.en }}" data-hu="{{ pages.home.featuredTitle.hu }}">{{ pages.home.featuredTitle.hu }}</h2>
    <div class="pottery-grid">
      {% set featuredItems = collections.pottery | available | featured %}
      {% for item in featuredItems %}
        <article class="pottery-card">
          <a href="/pottery/{{ item.fileSlug }}/">
            <div class="pottery-image-container">
              {% if item.data.images and item.data.images.length > 0 %}
                <img src="{{ item.data.images[0] }}" alt="{{ item.data.title }}" class="pottery-image">
              {% else %}
                <div class="pottery-image-placeholder"></div>
              {% endif %}
            </div>
            <div class="pottery-info">
              <h3 class="pottery-title" data-en="{{ item.data.title }}" data-hu="{{ item.data.title_hu or item.data.title }}">{{ item.data.title }}</h3>
              <p class="pottery-category">{{ item.data.category }}</p>
              <p class="pottery-price" data-hu="{{ item.data.price | currency }}" data-en="{{ item.data.price | currencyEn }}">{{ item.data.price | currency }}</p>
              {% if item.data.price_eur %}<p class="pottery-price-eur">{{ item.data.price_eur | currencyEur }}</p>{% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
    <div class="text-center">
      <a href="/available/" class="btn btn-secondary" data-en="{{ pages.home.viewAll.en }}" data-hu="{{ pages.home.viewAll.hu }}">{{ pages.home.viewAll.hu }}</a>
    </div>
  </div>
</section>
