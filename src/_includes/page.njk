---
layout: base.njk
---

<section class="page-header">
  <div class="container">
    <h1 data-en="{{ pages.about.title.en }}" data-hu="{{ pages.about.title.hu }}">{{ pages.about.title.hu }}</h1>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <div class="content-wrapper">
      <div class="artist-section">
        <img src="{{ pages.about.artistPhoto }}" alt="{{ pages.about.artistName.hu }}" class="artist-photo">
        <h2 data-en="{{ pages.about.artistName.en }}" data-hu="{{ pages.about.artistName.hu }}">{{ pages.about.artistName.hu }}</h2>
        <p class="location" data-en="📍 {{ pages.about.location.en }}" data-hu="📍 {{ pages.about.location.hu }}">📍 {{ pages.about.location.hu }}</p>
      </div>
      <div class="text-content">
        <h2 data-en="{{ pages.about.artist.title.en }}" data-hu="{{ pages.about.artist.title.hu }}">{{ pages.about.artist.title.hu }}</h2>
        <p data-en="{{ pages.about.artist.text.en }}" data-hu="{{ pages.about.artist.text.hu }}">{{ pages.about.artist.text.hu }}</p>

        <h2 data-en="{{ pages.about.process.title.en }}" data-hu="{{ pages.about.process.title.hu }}">{{ pages.about.process.title.hu }}</h2>
        <p data-en="{{ pages.about.process.text.en }}" data-hu="{{ pages.about.process.text.hu }}">{{ pages.about.process.text.hu }}</p>

        <h2 data-en="{{ pages.about.techniques.title.en }}" data-hu="{{ pages.about.techniques.title.hu }}">{{ pages.about.techniques.title.hu }}</h2>
        <p data-en="{{ pages.about.techniques.text.en }}" data-hu="{{ pages.about.techniques.text.hu }}">{{ pages.about.techniques.text.hu }}</p>

        <h2 data-en="{{ pages.about.studio.title.en }}" data-hu="{{ pages.about.studio.title.hu }}">{{ pages.about.studio.title.hu }}</h2>
        <p data-en="{{ pages.about.studio.text.en }}" data-hu="{{ pages.about.studio.text.hu | safe }}">{{ pages.about.studio.text.hu | safe }}</p>
      </div>
    </div>
  </div>
</section>
