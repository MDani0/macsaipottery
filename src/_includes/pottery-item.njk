---
layout: base.njk
---

<article class="pottery-detail">
  <div class="container">
    <div class="pottery-detail-grid">
      <div class="pottery-images">
        <div class="main-image-container">
          {% if images and images.length > 0 %}
            <img src="{{ images[0] }}" alt="{{ title }}" class="main-image" id="mainImage">
          {% endif %}
        </div>
        {% if images and images.length > 1 %}
          <div class="thumbnail-gallery">
            {% for image in images %}
              <button class="thumbnail {% if loop.index0 == 0 %}active{% endif %}" onclick="changeImage('{{ image }}', this)">
                <img src="{{ image }}" alt="{{ title }} - view {{ loop.index }}">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pottery-details">
        <h1 class="item-title" data-en="{{ title }}" data-hu="{{ title_hu or title }}">{{ title }}</h1>

        {% if status == "sold" %}
          <span class="status-badge sold" data-en="{{ sitewide.pottery.badges.sold.en }}" data-hu="{{ sitewide.pottery.badges.sold.hu }}">{{ sitewide.pottery.badges.sold.hu }}</span>
        {% else %}
          <span class="status-badge available" data-en="{{ sitewide.pottery.badges.available.en }}" data-hu="{{ sitewide.pottery.badges.available.hu }}">{{ sitewide.pottery.badges.available.hu }}</span>
        {% endif %}

        <p class="category-tag">{{ category }}</p>

        <p class="price" data-hu="{{ price | currency }}" data-en="{{ price | currencyEn }}">{{ price | currency }}</p>
        {% if price_eur %}
        <p class="price-eur">{{ price_eur | currencyEur }}</p>
        {% endif %}

        <div class="description item-description" data-en="{{ description }}" data-hu="{{ description_hu or description }}">
          {{ description | safe }}
        </div>

        <div class="specifications">
          <h3 data-en="{{ sitewide.pottery.specifications.en }}" data-hu="{{ sitewide.pottery.specifications.hu }}">{{ sitewide.pottery.specifications.hu }}</h3>
          <ul>
            {% if height %}
              <li><strong data-en="{{ sitewide.pottery.fields.height.en }}" data-hu="{{ sitewide.pottery.fields.height.hu }}">{{ sitewide.pottery.fields.height.hu }}:</strong> {{ height }} cm ({{ height | toInches }}")</li>
            {% endif %}
            {% if diameter %}
              <li><strong data-en="{{ sitewide.pottery.fields.diameter.en }}" data-hu="{{ sitewide.pottery.fields.diameter.hu }}">{{ sitewide.pottery.fields.diameter.hu }}:</strong> {{ diameter }} cm ({{ diameter | toInches }}")</li>
            {% endif %}
            {% if width %}
              <li><strong data-en="{{ sitewide.pottery.fields.width.en }}" data-hu="{{ sitewide.pottery.fields.width.hu }}">{{ sitewide.pottery.fields.width.hu }}:</strong> {{ width }} cm ({{ width | toInches }}")</li>
            {% endif %}
            {% if materials %}
              <li><strong data-en="{{ sitewide.pottery.fields.materials.en }}" data-hu="{{ sitewide.pottery.fields.materials.hu }}">{{ sitewide.pottery.fields.materials.hu }}:</strong> <span class="item-materials" data-en="{{ materials }}" data-hu="{{ materials_hu or materials }}">{{ materials }}</span></li>
            {% endif %}
            {% if technique %}
              <li><strong data-en="{{ sitewide.pottery.fields.technique.en }}" data-hu="{{ sitewide.pottery.fields.technique.hu }}">{{ sitewide.pottery.fields.technique.hu }}:</strong> <span class="item-technique" data-en="{{ technique }}" data-hu="{{ technique_hu or technique }}">{{ technique }}</span></li>
            {% endif %}
            {% if year %}
              <li><strong data-en="{{ sitewide.pottery.fields.year.en }}" data-hu="{{ sitewide.pottery.fields.year.hu }}">{{ sitewide.pottery.fields.year.hu }}:</strong> {{ year }}</li>
            {% endif %}
          </ul>
        </div>

        {% if status == "available" %}
          <a href="/contact/?item={{ title | urlencode }}" class="btn btn-primary btn-large" data-en="{{ sitewide.pottery.inquire.en }}" data-hu="{{ sitewide.pottery.inquire.hu }}">{{ sitewide.pottery.inquire.hu }}</a>
        {% else %}
          <p class="sold-notice" data-en="{{ sitewide.pottery.soldNotice.en }}" data-hu="{{ sitewide.pottery.soldNotice.hu }}">{{ sitewide.pottery.soldNotice.hu }}</p>
        {% endif %}

        <div class="navigation-links">
          <a href="/available/" class="back-link" data-en="{{ sitewide.pottery.backToGallery.en }}" data-hu="{{ sitewide.pottery.backToGallery.hu }}">{{ sitewide.pottery.backToGallery.hu }}</a>
        </div>
      </div>
    </div>
  </div>
</article>
