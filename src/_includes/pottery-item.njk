---
layout: base.njk
---

<article class="pottery-detail">
  <div class="container">
    <div class="pottery-detail-grid">
      <div class="pottery-images">
        <div class="main-image-container">
          {% if images and images.length > 0 %}
            <img src="{{ images[0] }}" alt="{{ title }}" class="main-image" id="mainImage">
          {% endif %}
        </div>
        {% if images and images.length > 1 %}
          <div class="thumbnail-gallery">
            {% for image in images %}
              <button class="thumbnail {% if loop.index0 == 0 %}active{% endif %}" onclick="changeImage('{{ image }}', this)">
                <img src="{{ image }}" alt="{{ title }} - view {{ loop.index }}">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pottery-details">
        <h1 class="item-title" data-en="{{ title }}" data-hu="{{ title_hu or title }}">{{ title }}</h1>

        {% if status == "sold" %}
          <span class="status-badge sold" data-i18n="pottery.sold">SOLD</span>
        {% else %}
          <span class="status-badge available" data-i18n="pottery.available">AVAILABLE</span>
        {% endif %}

        <p class="category-tag">{{ category }}</p>

        <p class="price" data-hu="{{ price | currency }}" data-en="{{ price | currencyEn }}">{{ price | currency }}</p>
        {% if price_eur %}
        <p class="price-eur">{{ price_eur | currencyEur }}</p>
        {% endif %}

        <div class="description item-description" data-en="{{ description }}" data-hu="{{ description_hu or description }}">
          {{ description | safe }}
        </div>

        <div class="specifications">
          <h3 data-i18n="pottery.specifications">Specifications</h3>
          <ul>
            {% if height %}
              <li><strong data-i18n="pottery.height">Height:</strong> {{ height }} cm ({{ height | toInches }}")</li>
            {% endif %}
            {% if diameter %}
              <li><strong data-i18n="pottery.diameter">Diameter:</strong> {{ diameter }} cm ({{ diameter | toInches }}")</li>
            {% endif %}
            {% if width %}
              <li><strong data-i18n="pottery.width">Width:</strong> {{ width }} cm ({{ width | toInches }}")</li>
            {% endif %}
            {% if materials %}
              <li><strong data-i18n="pottery.materials">Materials:</strong> <span class="item-materials" data-en="{{ materials }}" data-hu="{{ materials_hu or materials }}">{{ materials }}</span></li>
            {% endif %}
            {% if technique %}
              <li><strong data-i18n="pottery.technique">Technique:</strong> <span class="item-technique" data-en="{{ technique }}" data-hu="{{ technique_hu or technique }}">{{ technique }}</span></li>
            {% endif %}
            {% if year %}
              <li><strong data-i18n="pottery.year">Year:</strong> {{ year }}</li>
            {% endif %}
          </ul>
        </div>

        {% if status == "available" %}
          <a href="/contact/?item={{ title | urlencode }}" class="btn btn-primary btn-large" data-i18n="pottery.inquire">Inquire About This Piece</a>
        {% else %}
          <p class="sold-notice" data-i18n="pottery.soldNotice">This piece has been sold and is no longer available.</p>
        {% endif %}

        <div class="navigation-links">
          <a href="/available/" class="back-link" data-i18n="pottery.backToGallery">← Back to Gallery</a>
        </div>
      </div>
    </div>
  </div>
</article>
