---
layout: base.njk
title: Available Pieces
permalink: /available/
---

<section class="gallery-header">
  <div class="container">
    <h1 data-en="{{ pages.available.title.en }}" data-hu="{{ pages.available.title.hu }}">{{ pages.available.title.hu }}</h1>
    <p class="subtitle" data-en="{{ pages.available.subtitle.en }}" data-hu="{{ pages.available.subtitle.hu }}">{{ pages.available.subtitle.hu }}</p>
  </div>
</section>

<section class="gallery-filters">
  <div class="container">
    <div class="filter-buttons">
      <button class="filter-btn active" data-filter="all" data-en="{{ sitewide.gallery.filters.all.en }}" data-hu="{{ sitewide.gallery.filters.all.hu }}">{{ sitewide.gallery.filters.all.hu }}</button>
      <button class="filter-btn" data-filter="Bowl" data-en="{{ sitewide.gallery.filters.bowls.en }}" data-hu="{{ sitewide.gallery.filters.bowls.hu }}">{{ sitewide.gallery.filters.bowls.hu }}</button>
      <button class="filter-btn" data-filter="Vase" data-en="{{ sitewide.gallery.filters.vases.en }}" data-hu="{{ sitewide.gallery.filters.vases.hu }}">{{ sitewide.gallery.filters.vases.hu }}</button>
      <button class="filter-btn" data-filter="Mug" data-en="{{ sitewide.gallery.filters.mugs.en }}" data-hu="{{ sitewide.gallery.filters.mugs.hu }}">{{ sitewide.gallery.filters.mugs.hu }}</button>
      <button class="filter-btn" data-filter="Plate" data-en="{{ sitewide.gallery.filters.plates.en }}" data-hu="{{ sitewide.gallery.filters.plates.hu }}">{{ sitewide.gallery.filters.plates.hu }}</button>
      <button class="filter-btn" data-filter="Sculpture" data-en="{{ sitewide.gallery.filters.sculptures.en }}" data-hu="{{ sitewide.gallery.filters.sculptures.hu }}">{{ sitewide.gallery.filters.sculptures.hu }}</button>
      <button class="filter-btn" data-filter="Bonsai Pot" data-en="{{ sitewide.gallery.filters.bonsaiPots.en }}" data-hu="{{ sitewide.gallery.filters.bonsaiPots.hu }}">{{ sitewide.gallery.filters.bonsaiPots.hu }}</button>
      <button class="filter-btn" data-filter="Other" data-en="{{ sitewide.gallery.filters.other.en }}" data-hu="{{ sitewide.gallery.filters.other.hu }}">{{ sitewide.gallery.filters.other.hu }}</button>
    </div>
  </div>
</section>

<section class="gallery-content">
  <div class="container">
    {% set availableItems = collections.pottery | available %}
    {% if availableItems.length > 0 %}
      <div class="pottery-grid" id="potteryGrid">
        {% for item in availableItems %}
          <article class="pottery-card" data-category="{{ item.data.category }}">
            <a href="/pottery/{{ item.fileSlug }}/">
              <div class="pottery-image-container">
                {% if item.data.images and item.data.images.length > 0 %}
                  <img src="{{ item.data.images[0] }}" alt="{{ item.data.title }}" class="pottery-image" loading="lazy">
                {% else %}
                  <div class="pottery-image-placeholder"></div>
                {% endif %}
                <span class="status-overlay available" data-en="{{ sitewide.pottery.badges.available.en }}" data-hu="{{ sitewide.pottery.badges.available.hu }}">{{ sitewide.pottery.badges.available.hu }}</span>
              </div>
              <div class="pottery-info">
                <h3 class="pottery-title" data-en="{{ item.data.title }}" data-hu="{{ item.data.title_hu or item.data.title }}">{{ item.data.title }}</h3>
                <p class="pottery-category">{{ item.data.category }}</p>
                <p class="pottery-price" data-hu="{{ item.data.price | currency }}" data-en="{{ item.data.price | currencyEn }}">{{ item.data.price | currency }}</p>
                {% if item.data.price_eur %}<p class="pottery-price-eur">{{ item.data.price_eur | currencyEur }}</p>{% endif %}
              </div>
            </a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <p data-en="{{ sitewide.gallery.emptyStates.available.en }}" data-hu="{{ sitewide.gallery.emptyStates.available.hu }}">{{ sitewide.gallery.emptyStates.available.hu }}</p>
      </div>
    {% endif %}
  </div>
</section>
